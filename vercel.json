{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "app.py"
    },
    {
      "src": "/health",
      "dest": "app.py"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    {
      "src": "/dashboard-cliente",
      "dest": "/dashboard_cliente.html"
    },
    {
      "src": "/success",
      "dest": "/success.html"
    },
    {
      "src": "/ia",
      "dest": "/home_care_ia.html"
    },
    {
      "src": "/manual-do-produto.html",
      "dest": "/manual-do-produto.html"
    },
    {
      "src": "/privacidade.html",
      "dest": "/privacidade.html"
    },
    {
      "src": "/termos-de-uso.html",
      "dest": "/termos-de-uso.html"
    },
    {
      "src": "/plans.html",
      "dest": "/plans.html"
    },
    {
      "src": "/index.html",
      "dest": "/index.html"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.12"
  },
  "crons": [
    {
      "path": "/api/check-reminders",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 3 * * *"
    }
  ]
}